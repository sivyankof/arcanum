# Что НЕ уезжает в архив сборки EAS (задача 61).
#
# ⚠️ ГЛАВНОЕ: если этот файл существует, EAS ПЕРЕСТАЁТ читать .gitignore — вообще, целиком.
# Поэтому здесь продублировано всё, что раньше защищал .gitignore, и в первую очередь секреты:
# keystore, ключи и .env. Добавляешь новое правило в .gitignore — проверь, нужно ли оно тут.
# (.git и node_modules EAS исключает сам, независимо от этого файла.)
#
# Зачем файл нужен: без него архив весил 305 МБ и заливался минуту двадцать — почти всё
# это скриншоты веб-проверок и кэш сканов Commons, которых сборке не видно и не нужно.
# Сборке нужны ровно: app/, src/, assets/, content/ и корневые конфиги.

# --- секреты: НИКОГДА не должны уехать на сервер сборки ---
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env*.local

# --- зависимости и артефакты сборки ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
*.tsbuildinfo

# сгенерированные нативные папки: EAS делает prebuild сам
/ios
/android

# --- то, что не участвует в сборке (ради размера архива) ---
# документация проекта: спеки, планы, хроника и 119 МБ скриншотов веб-проверок
docs/
# python-конвейер контента и утилиты веб-проверки — запускаются только локально
scripts/
# юридические страницы: отдельный сайт на GitHub Pages, в приложение не входит
site/
# кэш оригиналов сканов Commons (scripts/fetch_card_scans.py, спека 42) — 67 МБ
.cache/

# --- служебное окружение разработчика ---
.claude/
.superpowers/
.vscode/
.github/
.playwright-mcp/
__pycache__/
*.pyc

# --- прочий мусор ---
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
